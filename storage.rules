rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Función auxiliar: verifica que sea la vendedora autenticada.
    function isVendedora() {
      return request.auth != null;
      // && request.auth.token.email == "tucorreo@ejemplo.com";
    }

    // Carpeta de fotos de los productos
    match /productos/{fileName} {
      // Cualquier visitante puede ver las imágenes del catálogo
      allow read: if true;

      // Solo la vendedora autenticada puede subir/actualizar imágenes (máx. 5 MB y formato imagen)
      allow create, update: if isVendedora()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Solo la vendedora autenticada puede eliminar imágenes de Storage al borrar o cambiar foto
      allow delete: if isVendedora();
    }
  }
}
